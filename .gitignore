# ============================
# Elector Lookup Portal
# Root .gitignore
# ============================

# --- Environment files (NEVER commit secrets) ---
.env
.env*
.env.local
etl/.env
web/.env.local
cookies.txt
web/cookies.txt

# --- Large Scanned PDF Rolls (Kept local due to GitHub 100MB file limit) ---
pdf-formate/
pdf-ocr made/
/data/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Node ---
node_modules/
.next/
out/
*.tsbuildinfo

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Temp / Scratch ---
~$*
etl/scratch_*
etl/*.txt
etl/page81_*
web/*.js

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

.vercel
