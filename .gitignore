# ============================
# Elector Lookup Portal
# Root .gitignore
# ============================

# --- Environment files (NEVER commit secrets) ---
.env
.env.local
etl/.env
web/.env.local

# --- Raw data ---
data/
excle-formate/
pdf-formate/
pdf-ocr made/

# --- ETL output ---
etl/output/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Node ---
node_modules/
.next/
out/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Temp / Scratch ---
etl/scratch_*
etl/*.txt
etl/page81_*
web/*.js

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

.vercel
.env*
*.xlsx
*.xls
*.csv
cookies.txt
web/cookies.txt
*.tsbuildinfo
