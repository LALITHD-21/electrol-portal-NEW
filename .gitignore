# --- Large Scanned PDF Rolls (Kept local due to GitHub 100MB file limit) ---
pdf-formate/
pdf-ocr made/
/data/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Node ---
node_modules/
.next/
.firebase/
out/
*.tsbuildinfo

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Temp / Scratch ---
~$*
etl/scratch_*
etl/*.txt
etl/page81_*

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

.vercel
public only view refernce photo/
web/test_pin.png
web/data/backups/
etl/reports/

